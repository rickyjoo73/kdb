KDB_POSTGRES_DB=kdb
KDB_POSTGRES_USER=kdb
KDB_POSTGRES_PASSWORD=change-me
KDB_POSTGRES_HOST_PORT=5436

DATABASE_URL=postgres://kdb:change-me@kdb-db:5432/kdb?sslmode=disable

KDB_API_PORT=9100
KDB_API_REQUEST_TIMEOUT_SECONDS=10
KDB_API_KEYS=

KDB_WORKER_FAST_INTERVAL_SECONDS=30
KDB_WORKER_POLL_INTERVAL_SECONDS=900
KDB_RESEARCH_INTERVAL_SECONDS=60
KDB_QUALITY_INTERVAL_SECONDS=86400
KDB_LOCALFILL_ENABLED=0
KDB_LOCALFILL_BATCH=10
KDB_LOCALFILL_REGROUND=0

# Unified OpenAI-compatible Gemma gateway. The gateway owns backend routing;
# KDB must not list individual backend hosts here.
KDB_GEMMA_BASE_URL=https://ai.aiinplanet.com
KDB_GEMMA_MODEL=gemma4
KDB_GEMMA_API_KEY=
KDB_GEMMA_CONCURRENCY=12
KDB_GEMMA_TIMEOUT_MS=240000
KDB_GEMMA_MAX_TOKENS=2048

# New automatic candidate-promotion lanes are canaries and default OFF.
KDB_REJUDGE_ENABLED=0
KDB_MUSICBRAINZ_DRAIN_ENABLED=0
KDB_KOFIC_DRAIN_ENABLED=0
KDB_WDPERSON_DRAIN_ENABLED=0
# Comma-separated exact article hosts allowed as positive intake provenance.
# Media domains in kwave_news_whitelist(discovery_enabled) are trusted as well.
KDB_INTAKE_TRUSTED_SOURCE_HOSTS=kstory.aiinplanet.com
# review 보류 키워드 자동 검증(오너: "없으면 검증 후 바로 추가작업"). 기본 on — 0 이면 끔.
# KDB 가 Naver(encyc→news)로 근거를 수집해 DecideIntake 재평가 통과분만 발굴 승격.
KDB_INTAKE_AUTOVERIFY=1
KDB_INTAKE_AUTOVERIFY_INTERVAL_SECONDS=120
KDB_INTAKE_AUTOVERIFY_BATCH=12
# Naver Open API 일일 쿼터(1,000) 보호 예산 — autoverify 가 하루에 쓰는 최대 호출 수.
KDB_INTAKE_AUTOVERIFY_DAILY_CALLS=600
# 일일 예산 중 fresh 레인(유입 즉시심사) 전용 예약분 — backlog 드레인은 이만큼 남기고 멈춤.
KDB_INTAKE_AUTOVERIFY_FRESH_RESERVE=120

# Immutable release identity exposed by /v1/health and admin ops health.
KDB_APP_IMAGE=kdb-app:ai-gateway-20260711-1
KDB_BUILD_VERSION=ai-gateway-20260711-1
KDB_CODEX_BRIDGE_URL=http://codex-bridge:9002/kdb_extract

# Google Cloud Translation v2 (miss 음차 제목류 재매칭 전용 — 읽기 경로만, 07-15)
# 미설정이면 번역 재매칭 전체 비활성(기존 동작 불변). 월 40만자 자체 상한.
KDB_GTRANSLATE_KEY=
