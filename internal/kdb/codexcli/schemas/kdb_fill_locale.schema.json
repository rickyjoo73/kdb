{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["spellings", "skipped"],
  "properties": {
    "spellings": {
      "type": "array",
      "maxItems": 9,
      "description": "요청된 missing_locales 중 합성에 성공한 것만.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "value", "confidence", "reason"],
        "properties": {
          "locale": {
            "type": "string",
            "enum": ["en", "ja", "vi", "zh", "zh_hant", "es", "id", "pt_br"]
          },
          "value": {
            "type": "string",
            "maxLength": 200,
            "description": "현지 매체가 사용할 표기."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.4,
            "maximum": 0.9,
            "description": "LLM fallback 은 0.5 default. 강한 근거(예: Wikidata sitelinks 매칭) 시 0.7~0.9."
          },
          "reason": {
            "type": "string",
            "maxLength": 100,
            "description": "왜 그 표기인지 한 줄."
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "maxItems": 9,
      "description": "충분한 근거가 없어 합성 거부한 locale.",
      "items": {
        "type": "string",
        "enum": ["en", "ja", "vi", "zh", "zh_hant", "es", "id", "pt_br"]
      }
    }
  }
}
