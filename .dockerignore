# Keep the kdb-app build context small and avoid unreadable host state.
# data/postgres is root-owned (postgres bind-mount) → "permission denied" if sent.
data/
*.sql
!migrations/*.sql

.git/
.github/

# Host / operator state — never part of the image build context.
.codex/
.docker/
.local/
.npm/
.cache/
.config/
.claude/
.hermes/
.claude.json
.bash_history
.ssh/
.agents/
.gomodcache/
.gocache/
.bash*
.profile
.gitconfig

# Prebuilt host binaries / dumps.
kdb-api
kdb-admin
kdb-worker
kdb
*.log
tmp/
logs/
backups/

# Runtime secrets are injected by compose and must never be baked into a
# reviewable release image.
.env
.env.*
!.env.example
