            "body_template": {"terms": ["합성엔터티"], "locales": ["${MATRIX_LOCALE}"]}
          },
          {
            "name": "kdb_durable_prepare",
            "method": "POST",
            "route": "/v1/preparations",
            "headers": {"Authorization": "Bearer ${KDB_READ_OWNER_TOKEN}", "Idempotency-Key": "R05-${MATRIX_LOCALE}", "Content-Type": "application/json"},
            "body_template": {"terms": [{"ko": "합성엔터티"}], "locales": ["${MATRIX_LOCALE}"]}
          },
          {
            "name": "tdb_lookup",
            "method": "POST",
            "route": "/v1/places/lookup",
            "headers": {"X-TDB-Key": "${TDB_CONSUMER_TOKEN}", "Content-Type": "application/json"},
            "body_template": {"locale": "${MATRIX_LOCALE}", "text": "합성산", "region_hint": ""}
