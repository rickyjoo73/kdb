    {
      "id": "R01",
      "title": "KDB structured error and official client decoding",
      "execution_status": "not_executed_source_finding_only",
      "actual_consumer_status": "unconfirmed",
      "fixture": {
        "request": {
          "method": "POST",
          "route": "/v1/entities/match",
          "headers": {
            "Authorization": "Bearer ${KDB_READ_OWNER_TOKEN}",
            "Content-Type": "application/json"
          },
          "body": {
            "locale": "ja"
          }
        }
      },
      "expected_legacy": {
        "server_assertions": [
          {"op": "http_status", "value": 400},
          {"op": "equals", "path": "$.ok", "value": false},
          {"op": "equals", "path": "$.error.code", "value": "bad_request"},
          {"op": "equals", "path": "$.error.message", "value": "source_text required"}
        ],
        "official_client_observation": "The client attempts to decode $.error as a string, ignores that decode error, and falls back to the HTTP status text."
      },
      "proposed_target": {
        "assertions": [
          {"op": "http_status", "value": 400},
          {"op": "equals", "path": "$.error.code", "value": "bad_request"},
          {"op": "equals", "path": "client.error.code", "value": "bad_request"},
          {"op": "equals", "path": "client.error.message", "value": "source_text required"},
          {"op": "equals", "path": "client.error.retryable", "value": false}
        ]
      },
      "code_evidence": [
        "KDB:internal/kdbapi/api.go:2028-2042",
        "KDB:internal/kdbapi/api.go:3376-3385",
        "KDB:pkg/kdbclient/client.go:514-523",
        "KDB:pkg/kdbclient/client_test.go:465-475"
      ]
    },
