      "execution_status": "not_executed",
      "actual_consumer_status": "unconfirmed",
      "fixture": {
        "preconditions": [
          "Two active synthetic places share ko=합성중앙 but have different UUIDs and region tokens.",
          "Neither candidate has a prominence margin large enough to resolve without context."
        ],
        "requests": [
          {
            "name": "without_hint",
            "method": "POST",
            "route": "/v1/places/match",
            "headers": {"X-TDB-Key": "${TDB_CONSUMER_TOKEN}", "Content-Type": "application/json"},
            "body": {"locale": "ja", "names": ["합성중앙"], "region_hint": ""}
          },
          {
            "name": "with_hint",
            "method": "POST",
            "route": "/v1/places/match",
            "headers": {"X-TDB-Key": "${TDB_CONSUMER_TOKEN}", "Content-Type": "application/json"},
            "body": {"locale": "ja", "names": ["합성중앙"], "region_hint": "합성북도 합성시"}
          }
        ]
      },
      "expected_legacy": {
        "assertions": [
          {"op": "equals", "request": "without_hint", "path": "$.results.합성중앙.status", "value": "ambiguous"},
          {"op": "length_equals", "request": "without_hint", "path": "$.results.합성중앙.candidates", "value": 2},
          {"op": "different_from", "path": "candidate[0].place_id", "other_path": "candidate[1].place_id"},
          {"op": "equals", "request": "with_hint", "path": "$.results.합성중앙.status", "value": "found"},
          {"op": "present", "request": "with_hint", "path": "$.results.합성중앙.place.place_id"}
        ]
      },
      "proposed_target": {
        "assertions": [
          {"op": "equals", "path": "$.items[0].requested_name", "value": "합성중앙"},
          {"op": "one_of", "path": "$.items[0].resolution_state", "value": ["ambiguous", "resolved"]},
          {"op": "present", "when": "resolved", "path": "$.items[0].resolved_id"},
          {"op": "length_equals", "when": "ambiguous", "path": "$.items[0].candidates", "value": 2}
