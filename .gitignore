.DS_Store
.idea/
.vscode/

# Host / operator state — never commit
.bash_history
.claude/
.claude.json
.codex/
.worktrees/
.docker/
.local/
.npm/

# Postgres bind-mount + DB dumps stay out of repo
data/
*.sql
!migrations/*.sql
# P1 격리 구조/시험은 버전 관리한다. migrations/ 밖에 두는 이유는 배포가
# `ls migrations/*.sql`(비재귀)로만 적용해서 여기 있는 한 자동 적용되지 않기 때문이다.
# 운영 반영은 P3.02 의 결정이다.
!docs/p1/*.sql
!docs/p2/*.sql
!docs/p3/*.sql
# ★docs/p4 도 반드시 여기 있어야 한다 (2026-09-14).
# 빠져 있었고, 그래서 `git add -A` 와 커밋이 **성공했는데 P4 SQL 만 조용히 빠졌다**.
# 서버에서 파일이 없어 실행이 죽고 나서야 알았다. 새 단계 디렉터리를 만들면 여기도 늘린다
# — validate-kdb-runtime-config 가 docs/p* 전체를 훑어 빠진 것을 잡는다.
!docs/p4/*.sql
/kdb-admin
/kdb-api
/kdb-worker
/kdb-app
/kdb
/backups/
.claude.json.tmp.*
searxng/
.gomodcache/
.gocache/
.hermes/
scripts/cleanup-20260614/
scripts/cleanup-20260710/

# 2026-08-04: GitHub Actions 배포용 SSH 키/캐시/백업 — 절대 커밋 금지
.ssh/
.cache/
pre-migration-backup/
.resume_tools/
