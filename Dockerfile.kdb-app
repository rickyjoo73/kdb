# kdb-app — consolidated single-binary KDB platform image.
#
# ★codex 를 이미지에서 들어냈다 (운영자 지시 2026-09-16 "codex 사용은 폐기해,
#   사용이 안 되도록"). 종전엔 npm 으로 codex CLI 를 깔고 그것 때문에 Node 22 까지
#   얹었다 — 앱은 Go 바이너리 하나인데 이미지에 런타임이 둘 있었다.
#
#   그 껍데기가 실제로 사람을 속였다(2026-09-16): 컨테이너 안에 codex 0.146.0 이
#   있고 환경변수가 11개 붙어 있어, 손으로 불러 401 을 받고는 "앱이 codex 를 부르는데
#   전부 실패한다"고 보고했다. 앱은 2026-09-15 부터 codex 를 부르지 않는다.
#   **안 쓰는 것은 없애야 한다** — 남겨 두면 다음 사람이 같은 결론에 또 도달한다.
#
# Build (from repo root):
#   docker build -f Dockerfile.kdb-app -t kdb-app:local .
#
# REQUIRED RUNTIME MOUNTS / ENV (see docker-compose.kdb.yml):
#   - Source is baked into the immutable image; production does not bind-mount the repo.
#   - Go caches: go-mod-cache -> /go/pkg/mod, go-build-cache -> a writable
#     cache dir matching the run user (compose maps it to /home/kdb/.cache/go-build).
#   - LLM 은 gemma 하나다(KDB_GEMMA_BASE_URL). 이미지에 LLM 클라이언트가 없다.
FROM golang:1.23-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates(외부 API TLS) · curl(헬스체크) · tini(PID 1). Node 는 codex 를
# 깔려고만 있었으므로 같이 뺐다.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tini \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build the consolidated binary into the immutable runtime image.
COPY . /app
RUN GOFLAGS=-buildvcs=false go build -o /usr/local/bin/kdb-app ./cmd/kdb

ENV KDB_API_PORT=9100 \
    KDB_ADMIN_PORT=9101

EXPOSE 9100 9101

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["kdb-app"]
